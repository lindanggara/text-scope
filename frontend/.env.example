# Alamat backend FastAPI (tanpa garis miring di akhir)
VITE_API_URL=http://localhost:8000

# true  = pakai data dummy (backend belum siap)
# false = kirim file ke backend sungguhan
VITE_USE_MOCK=true

# Login & role (Supabase → Project Settings → API)
# Pakai publishable / anon key, JANGAN service_role key.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-publishable-atau-anon-key
